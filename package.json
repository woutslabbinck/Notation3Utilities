{
  "name": "n3-utility",
  "version": "0.1.0",
  "description": "Reasoning utilities for the Notation 3 reasoning language that work in the browser and Node.",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "browser": "./dist/esm/index.browser.js"
    }
  },
  "main": "./dist/cjs/index.js",
  "files": [ "dist" ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json",
    "clean": "rm -rf ./dist",
    "prepare": "npm run build",
    "release": "npm run build && npm publish --access public",
    "test": "npm run test:browser && npm run test:node",
    "test:browser": "vitest run --browser",
    "test:node": "vitest run -c vitest.node.config.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woutslabbinck/Notation3Utilities.git"
  },
  "keywords": [ "Notation3", "Reasoning" ],
  "author": "Wout Slabbinck",
  "license": "MIT",
  "bugs": { "url": "https://github.com/woutslabbinck/Notation3Utilities/issues" },
  "homepage": "https://github.com/woutslabbinck/Notation3Utilities#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/jest": "^30.0.0",
    "@types/tmp": "^0.2.6",
    "@vitest/browser-playwright": "^4.1.7",
    "playwright": "^1.60.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "@types/n3": "^1.26.1",
    "eyeling": "^1.10.6",
    "eyereasoner": "^21.1.10",
    "n3": "^2.0.3",
    "tmp": "^0.2.3"
  }
}
